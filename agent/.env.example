# Copy to agent/.env and fill in.

# Your OpenRouter API key (https://openrouter.ai/keys).
OPENROUTER_API_KEY=
# Any OpenRouter model id that supports tool calling, e.g. openai/gpt-4.1-mini.
AGENT_MODEL=

# Trek API, including the /api prefix.
TREK_API_URL=http://localhost:3000/api

# Optional
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# CONVERSATION_TTL_MINUTES=120
# AGENT_HOST=127.0.0.1
# AGENT_PORT=8000

# Browser origins allowed to call the agent (the web app), comma-separated.
# CORS_ORIGINS=http://localhost:5173
