
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ItineraryStatus {
  DRAFT
  PLANNED
  COMPLETED
  CANCELLED
}

model User {
  id String @id @default(uuid())
  email String @unique
  passwordHash String
  firstName String
  lastName String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  itineraries Itinerary[]
}

model Destination {
  id String @id @default(uuid())
  name String
  city String
  country String
  description String?
  latitude Decimal?
  longitude Decimal?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hotels Hotel[]
  airports Airport[]
  itineraries Itinerary[]
}

model Hotel {
  id String @id @default(uuid())
  destinationId String 
  name String
  address String
  rating Decimal?
  nightlyRate Decimal
  currency String
  availableRooms Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  destination Destination @relation(fields: [destinationId], references: [id])
  itineraryHotels ItineraryHotel[]
}

model Airport {
  id String @id @default(uuid())
  destinationId String
  code String @unique
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  destination Destination @relation(fields: [destinationId], references: [id])
  departingFlights Flight[] @relation("DepartingFlights")
  arrivingFlights Flight[] @relation("ArrivingFlights")
}

model Flight {
  id String @id @default(uuid())
  departureAirportId String
  arrivalAirportId String
  airline String
  flightNumber String
  departureAt DateTime
  arrivalAt DateTime
  price Decimal
  currency String
  availableSeats Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departureAirport Airport @relation("DepartingFlights", fields: [departureAirportId], references: [id])
  arrivalAirport Airport @relation("ArrivingFlights", fields: [arrivalAirportId], references: [id])
  itineraryFlight ItineraryFlight[]
}

model Itinerary {
  id String @id @default(uuid())
  userId String 
  destinationId String
  name String
  startDate DateTime
  endDate DateTime
  status ItineraryStatus
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  destination Destination @relation(fields: [destinationId], references: [id])
  itineraryHotel ItineraryHotel[]
  itineraryFlight ItineraryFlight[]
}

model ItineraryHotel {
  id String @id @default(uuid())
  itineraryId String
  hotelId String
  checkInDate DateTime
  checkOutDate DateTime
  rooms Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  itinerary Itinerary @relation(fields: [itineraryId], references: [id])
  hotel Hotel @relation(fields: [hotelId], references: [id])
}

model ItineraryFlight {
  id String @id @default(uuid())
  itineraryId String
  flightId String
  createdAt DateTime @default(now())

  itinerary Itinerary @relation(fields: [itineraryId], references: [id])
  flight Flight @relation(fields: [flightId], references: [id])
}