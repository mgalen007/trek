
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ItineraryStatus {
  DRAFT
  PLANNED
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  HELD
  CONFIRMED
  CANCELLED
}

enum Role {
  ADMIN
  USER
}

model User {
  id String @id @default(uuid())
  email String @unique
  passwordHash String
  firstName String
  lastName String
  role Role @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  itineraries Itinerary[]
  preferences UserPreferences?
  travelers Traveler[]

  @@map("users")
}

// Defaults the platform (and later the AI agent) uses when planning for a user.
model UserPreferences {
  userId String @id
  homeAirportId String?
  currency String?
  maxNightlyRate Decimal?
  minHotelRating Decimal?
  defaultTravelers Int @default(1)
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  homeAirport Airport? @relation(fields: [homeAirportId], references: [id], onDelete: SetNull)

  @@map("user_preferences")
}

// A person a user books travel for (themselves, family, colleagues).
// Deliberately no passport data until real airline integrations need it.
model Traveler {
  id String @id @default(uuid())
  userId String
  firstName String
  lastName String
  dateOfBirth DateTime @db.Date
  nationality String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  flightBookings ItineraryFlight[] @relation("FlightBookingTravelers")

  @@index([userId])
  @@map("travelers")
}

model Destination {
  id String @id @default(uuid())
  name String
  city String
  country String
  description String?
  latitude Decimal?
  longitude Decimal?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hotels Hotel[]
  airports Airport[]
  itineraries Itinerary[]

  @@map("destinations")
}

model Hotel {
  id String @id @default(uuid())
  destinationId String 
  name String
  address String
  rating Decimal?
  nightlyRate Decimal
  currency String
  totalRooms Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  destination Destination @relation(fields: [destinationId], references: [id])
  itineraryHotels ItineraryHotel[]

  @@index([destinationId])
  @@map("hotels")
}

model Airport {
  id String @id @default(uuid())
  destinationId String
  code String @unique
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  destination Destination @relation(fields: [destinationId], references: [id])
  departingFlights Flight[] @relation("DepartingFlights")
  arrivingFlights Flight[] @relation("ArrivingFlights")
  homeAirportFor UserPreferences[]

  @@index([destinationId])
  @@map("airports")
}

model Flight {
  id String @id @default(uuid())
  departureAirportId String
  arrivalAirportId String
  airline String
  flightNumber String
  departureAt DateTime
  arrivalAt DateTime
  price Decimal
  currency String
  availableSeats Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departureAirport Airport @relation("DepartingFlights", fields: [departureAirportId], references: [id])
  arrivalAirport Airport @relation("ArrivingFlights", fields: [arrivalAirportId], references: [id])
  itineraryFlight ItineraryFlight[]

  @@index([departureAirportId, departureAt])
  @@index([arrivalAirportId, departureAt])
  @@index([departureAt])
  @@map("flights")
}

model Itinerary {
  id String @id @default(uuid())
  userId String 
  destinationId String
  name String
  startDate DateTime
  endDate DateTime
  status ItineraryStatus @default(DRAFT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  destination Destination @relation(fields: [destinationId], references: [id])
  itineraryHotel ItineraryHotel[]
  itineraryFlight ItineraryFlight[]

  @@index([userId])
  @@map("itineraries")
}

model ItineraryHotel {
  id String @id @default(uuid())
  itineraryId String
  hotelId String
  checkInDate DateTime
  checkOutDate DateTime
  rooms Int
  status BookingStatus @default(HELD)
  nightlyRate Decimal
  totalPrice Decimal
  currency String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  itinerary Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  hotel Hotel @relation(fields: [hotelId], references: [id])

  @@index([hotelId, checkInDate, checkOutDate])
  @@map("itinerary_hotel")
}

model ItineraryFlight {
  id String @id @default(uuid())
  itineraryId String
  flightId String
  passengers Int
  status BookingStatus @default(HELD)
  unitPrice Decimal
  totalPrice Decimal
  currency String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  itinerary Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  flight Flight @relation(fields: [flightId], references: [id])
  travelers Traveler[] @relation("FlightBookingTravelers")

  @@map("itinerary_flight")
}